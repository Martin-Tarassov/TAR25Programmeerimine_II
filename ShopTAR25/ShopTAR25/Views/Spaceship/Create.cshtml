@model ShopTAR25.Models.Spaceship.SpaceshipCreateViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<form method="post" enctype="multipart/form-data">
    <input asp-for="Id" type="hidden" />
    <input asp-for="CreatedAt" type="hidden" />
    <input asp-for="ModifiedAt" type="hidden" />

    <div class="row mb-2 align-items-center">
        <label asp-for="Name" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Name" class="form-control" />
        </div>
    </div>

    <div class="row mb-2 align-items-center">
        <label asp-for="Classification" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Classification" class="form-control" />
        </div>
    </div>

    <div class="row mb-2 align-items-center">
        <label asp-for="BuiltDate" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="BuiltDate" class="form-control" type="datetime-local" />
        </div>
    </div>

    <div class="row mb-2 align-items-center">
        <label asp-for="Crew" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Crew" class="form-control" />
        </div>
    </div>

    <div class="row mb-2 align-items-center">
        <label asp-for="EnginePower" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="EnginePower" class="form-control" />
        </div>
    </div>

    <div class="row mb-2 align-items-center">
        <label class="col-sm-2 col-form-label">Files</label>
        <div class="col-sm-10">
            <input type="file" name="files" class="form-control" multiple />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-sm-2"></div>
        <div class="col-sm-10">
            <button type="submit" class="btn btn-success">Create</button>
            <a asp-controller="Spaceship" asp-action="Index" class="btn btn-success">Back</a>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}